{
  "name": "pirate-king-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pirate King player-facing front end. Builds to one self-contained dist/pirate-king.html.",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "sync-levels": "node scripts/sync-runtime.mjs --levels-only",
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "test:e2e": "node tests/app.browser.mjs",
    "test": "npm run build && npm run test:e2e",
    "build:site": "vite build && node scripts/postbuild.mjs --site",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "test:worker": "node --test tests/worker.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "wrangler": "^4.151.1"
  }
}
